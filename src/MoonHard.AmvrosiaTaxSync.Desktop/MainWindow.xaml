<Window x:Class="MoonHard.AmvrosiaTaxSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amvrosia TaxSync by MoonHard"
        Width="1380" Height="860" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource AppBackground}"
        PreviewKeyDown="HandlePreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ConnectionNavigation" TargetType="Button"
               BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnectionPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExplorerNavigation" TargetType="Button"
               BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExplorerPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CustomersNavigation" TargetType="Button"
               BasedOn="{StaticResource SidebarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustomersPage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Πλευρική πλοήγηση εφαρμογής -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,27,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,46">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AccentBrush}" Width="44" Height="44"
                                CornerRadius="12" Margin="0,0,11,0">
                            <TextBlock Text="A" FontSize="23" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Amvrosia" FontWeight="Bold" FontSize="19"/>
                            <TextBlock Text="TaxSync  by MoonHard" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="12,0,0,15"/>
                    <Button Content="▣   Σύνδεση SQL" Click="ConnectionPage_Click"
                            AutomationProperties.Name="Σελίδα σύνδεσης SQL"
                            Style="{StaticResource ConnectionNavigation}"/>
                    <Button Content="▤   Schema Explorer" Click="ExplorerPage_Click"
                            AutomationProperties.Name="Σελίδα Schema Explorer"
                            Style="{StaticResource ExplorerNavigation}"/>
                    <Button Content="☷   Πελάτες Αμβροσίας" Click="CustomersPage_Click"
                            AutomationProperties.Name="Σελίδα πελατών Αμβροσίας"
                            Style="{StaticResource CustomersNavigation}"
                            ToolTip="Ctrl+3 — Πελάτες Αμβροσίας"/>
                </StackPanel>

                <Border Grid.Row="3" Background="{DynamicResource ElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="●  READ-ONLY" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Ασφαλής ανάγνωση SQL metadata. Δεν εκτελούνται αλλαγές στο ERP."
                                   TextWrapping="Wrap" TextTrimming="None" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,9,0,0" LineHeight="19"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4" Margin="10,0,0,0">
                    <TextBlock Text="v0.3.0 • Customer Discovery" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="© MoonHard" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Κύρια περιοχή εργασίας -->
        <Grid Grid.Column="1" Margin="30,25,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MOONHARD / WORKSPACE" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding PageTitle}" FontSize="29" FontWeight="Bold"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="Επαγγελματικά εργαλεία ελέγχου και διαχείρισης συνδέσεων"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding ThemeButtonText}" Click="Theme_Click"
                        AutomationProperties.Name="Εναλλαγή φωτεινού και σκοτεινού θέματος"
                        VerticalAlignment="Center" MinWidth="140"
                        ToolTip="Ctrl+Shift+L — Αλλαγή θέματος"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,0">

                <!-- Σελίδα σύνδεσης: UDL και χειροκίνητη εισαγωγή -->
                <ScrollViewer Visibility="{Binding IsConnectionPage, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="23" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="01  /  IMPORT CONNECTION" FontWeight="Bold"
                                               FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Σύνδεση από αρχείο UDL" FontWeight="SemiBold"
                                               FontSize="19" Margin="0,9,0,0"/>
                                    <TextBlock Text="Διάβασε αυτόματα Server, Database και Authentication από υπάρχον .udl"
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding UdlFileName}" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="↑  Φόρτωση UDL"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="{Binding IsIdle}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Φόρτωση αρχείου UDL"
                                        ToolTip="Ctrl+O — Φόρτωση UDL" Click="ImportUdl_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="24">
                            <StackPanel>
                                <TextBlock Text="02  /  CONNECTION DETAILS" FontSize="12"
                                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Στοιχεία SQL Server" FontWeight="SemiBold"
                                           FontSize="19" Margin="0,9,0,0"/>
                                <TextBlock Text="Μπορείς να επεξεργαστείς τα στοιχεία πριν τη σύνδεση."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12" Margin="0,5,0,0"/>
                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,17">
                                        <TextBlock Text="Server / Instance" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ServerInput" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsIdle}"
                                                 AutomationProperties.Name="SQL Server ή Instance"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,17">
                                        <TextBlock Text="Database" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Όνομα βάσης"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,17">
                                        <TextBlock Text="Port  (0 = default)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsIdle}" AutomationProperties.Name="SQL θύρα"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,17">
                                        <TextBlock Text="Connection timeout (sec)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Timeout σύνδεσης"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,2,0,18">
                                        <CheckBox Content="Windows Authentication" IsChecked="{Binding WindowsAuthentication}"
                                                  IsEnabled="{Binding IsIdle}" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0">
                                        <TextBlock Text="SQL Username" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsSqlAuthentication}"
                                                 AutomationProperties.Name="SQL Username"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="2">
                                        <TextBlock Text="SQL Password" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="SqlPassword" IsEnabled="{Binding IsSqlAuthentication}"
                                                     AutomationProperties.Name="SQL Password"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Η προσωρινή εξαίρεση ενεργοποιείται μόνο με ρητή επιβεβαίωση. -->
                                <Border Background="{DynamicResource ElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="15" Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ΑΣΦΑΛΕΙΑ ΣΥΝΔΕΣΗΣ TLS"
                                                   FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding CertificateTrustDetails}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" TextTrimming="None"
                                                   Margin="0,8,0,12" FontSize="12"/>
                                        <Button Content="{Binding CertificateTrustButtonText}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="Εναλλαγή προσωρινής εξαίρεσης πιστοποιητικού TLS"
                                                IsEnabled="{Binding IsIdle}"
                                                ToolTip="Ctrl+Shift+C — Μόνο για εξουσιοδοτημένη δοκιμαστική σύνδεση"
                                                Click="CertificateTrust_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,22,0,20"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="↗  Έλεγχος σύνδεσης" Click="TestConnection_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            IsEnabled="{Binding IsIdle}" Margin="0,0,10,0"
                                            ToolTip="Ctrl+T — Έλεγχος σύνδεσης"/>
                                    <Button Content="▤  Επιθεώρηση schema" Click="InspectSchema_Click"
                                            IsEnabled="{Binding IsIdle}" Margin="0,0,10,0"
                                            ToolTip="Ctrl+R — Επιθεώρηση schema"/>
                                    <Button Content="Ακύρωση" Click="Cancel_Click"
                                            IsEnabled="{Binding IsBusy}" ToolTip="Esc — Ακύρωση"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Οι κωδικοί SQL χρησιμοποιούνται μόνο για τη σύνδεση και δεν αποθηκεύονται στις ρυθμίσεις."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   Margin="4,14,0,12" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Λίστα πελατών: ανάγνωση χωρίς μεταβολή στοιχείων ERP -->
                <Grid Visibility="{Binding IsCustomersPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="15" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="ΣΥΝΟΛΟ ΠΕΛΑΤΩΝ" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Customers.Total, StringFormat={}{0:N0}}"
                                           FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="15" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="ΜΕ ΑΦΜ" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Customers.WithAfm, StringFormat={}{0:N0}}"
                                           FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="15" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="ΧΩΡΙΣ ΑΦΜ" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Customers.WithoutAfm, StringFormat={}{0:N0}}"
                                           FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CustomerSearchBox"
                                 Text="{Binding Customers.Search, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Αναζήτηση πελάτη"
                                 ToolTip="Αναζήτηση κωδικού, επωνυμίας, ονόματος ή ΑΦΜ. Enter για εκτέλεση."/>
                        <Button Grid.Column="2" Content="Αναζήτηση / Ανανέωση"
                                Click="LoadCustomers_Click"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding IsIdle}"
                                AutomationProperties.Name="Ανανέωση πελατών"/>
                        <CheckBox Grid.Row="1" Grid.ColumnSpan="3"
                                  Content="Μόνο πελάτες με ΑΦΜ"
                                  IsChecked="{Binding Customers.OnlyWithAfm}"
                                  Margin="2,10,0,0"
                                  AutomationProperties.Name="Φίλτρο μόνο πελατών με ΑΦΜ"/>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="13" Padding="12">
                        <DataGrid ItemsSource="{Binding Customers.Rows}"
                                  AutomationProperties.Name="Πελάτες TblSnCustomer"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Κωδικός" Binding="{Binding Code}" Width="105"/>
                                <DataGridTextColumn Header="Επωνυμία" Binding="{Binding DisplayName}" Width="2*"/>
                                <DataGridTextColumn Header="Όνομα" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="ΑΦΜ" Binding="{Binding Afm}" Width="120"/>
                                <DataGridTextColumn Header="Έλεγχος ΑΦΜ" Binding="{Binding AfmStatusLabel}" Width="125"/>
                                <DataGridTextColumn Header="Κατάσταση" Binding="{Binding ActivityLabel}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="← Προηγούμενη"
                                Margin="0,0,9,0" Click="PreviousCustomers_Click"
                                IsEnabled="{Binding Customers.HasPrevious}"
                                ToolTip="Προηγούμενη σελίδα"/>
                        <Button Grid.Column="1" Content="Επόμενη →"
                                Click="NextCustomers_Click"
                                IsEnabled="{Binding Customers.HasNext}"
                                ToolTip="Επόμενη σελίδα"/>
                        <TextBlock Grid.Column="2" Text="{Binding Customers.PageLabel}"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="14,0,0,0" FontSize="12"/>
                    </Grid>
                </Grid>

                <!-- Σελίδα αναγνώρισης πραγματικού schema -->
                <Grid Visibility="{Binding IsExplorerPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Εξερεύνηση SQL Schema" FontWeight="SemiBold" FontSize="19"/>
                            <TextBlock Text="Πίνακες, views, τύποι πεδίων, primary και foreign keys"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⟳  Ανανέωση schema"
                                Click="InspectSchema_Click" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding IsIdle}" VerticalAlignment="Center"
                                ToolTip="Ctrl+R — Επανάληψη επιθεώρησης"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SchemaSearchBox"
                                 Text="{Binding SchemaSearch, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Αναζήτηση πίνακα ή view"
                                 ToolTip="Ctrl+F — Αναζήτηση πίνακα ή view"/>
                        <TextBlock Grid.Column="1" Margin="17,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                            <Run Text="Σύνολο: "/><Run Text="{Binding ObjectCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="13" Padding="15">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="ΠΙΝΑΚΕΣ &amp; VIEWS" FontSize="13"
                                           FontWeight="Bold" Margin="2,2,0,15"
                                           DockPanel.Dock="Top"/>
                                <DataGrid ItemsSource="{Binding SchemaView}"
                                          SelectedItem="{Binding SelectedObject, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Αντικείμενο" Binding="{Binding QualifiedName}" Width="*"/>
                                        <DataGridTextColumn Header="Τύπος" Binding="{Binding Kind}" Width="90"/>
                                        <DataGridTextColumn Header="Πεδία" Binding="{Binding ColumnCount}" Width="62"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="13" Padding="15">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="2,2,0,14">
                                    <TextBlock Text="ΠΕΔΙΑ ΑΝΤΙΚΕΙΜΕΝΟΥ" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding SelectedObjectLabel}" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding SelectedColumns}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Πεδίο" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Τύπος" Binding="{Binding DataType}" Width="100"/>
                                        <DataGridCheckBoxColumn Header="NULL" Binding="{Binding IsNullable}" Width="62"/>
                                        <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey}" Width="48"/>
                                        <DataGridCheckBoxColumn Header="FK" Binding="{Binding IsForeignKey}" Width="48"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Μόνιμη, ευανάγνωστη περιοχή κατάστασης -->
            <!-- Οι κωδικοί και οι οδηγίες διάγνωσης εμφανίζονται χωρίς προσωπικά δεδομένα. -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasSqlFailure, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="{Binding FailureTitle}" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="None" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding FailureGuidance}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="None" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        <TextBlock Text="{Binding FailureTechnical}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="None" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Αντιγραφή διάγνωσης"
                            Click="CopyDiagnostics_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="Αντιγραφή ασφαλούς SQL διάγνωσης"
                            ToolTip="Αντιγράφει κωδικό SQL, State, Severity και Connection ID χωρίς credentials"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" ToolTip="{Binding Status}"/>
                    <TextBlock Grid.Column="1" Text="Ctrl+O  UDL   •   Ctrl+Shift+L  Theme   •   Esc  Cancel"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
