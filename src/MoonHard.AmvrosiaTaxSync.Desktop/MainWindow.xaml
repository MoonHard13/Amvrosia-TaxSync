<Window x:Class="MoonHard.AmvrosiaTaxSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amvrosia TaxSync by MoonHard"
        Width="1250" Height="830" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        PreviewKeyDown="HandlePreviewKeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="AMVROSIA TAXSYNC" Foreground="{StaticResource AccentBrush}"
                       FontSize="14" FontWeight="Bold"/>
            <TextBlock Text="Έλεγχος &amp; επιθεώρηση SQL Server" FontSize="28"
                       FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="by MoonHard  •  Στάδιο 1: ασφαλής ανάγνωση και αναγνώριση schema"
                       Foreground="#AABDD0" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                CornerRadius="12" Padding="20" Margin="0,20,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="ΣΥΝΔΕΣΗ SQL SERVER"
                           FontSize="15" FontWeight="Bold" Margin="0,0,0,16"/>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Server / Instance" Margin="0,0,0,5"/>
                    <TextBox x:Name="ServerInput" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="Port (0 = default)" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,12">
                    <TextBlock Text="Database" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,12">
                    <TextBlock Text="Timeout (sec)" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5,12,0">
                    <CheckBox Content="Windows Authentication"
                              IsChecked="{Binding WindowsAuthentication}"
                              Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,0">
                    <TextBlock Text="SQL Username" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsSqlAuthentication}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="3">
                    <TextBlock Text="SQL Password" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="SqlPassword" IsEnabled="{Binding IsSqlAuthentication}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,14" LastChildFill="True">
            <Button Content="Έλεγχος σύνδεσης  Ctrl+T" Click="TestConnection_Click"
                    IsEnabled="{Binding IsIdle}" DockPanel.Dock="Left" Background="#216BA1"/>
            <Button Content="Επιθεώρηση schema  Ctrl+R" Click="InspectSchema_Click"
                    IsEnabled="{Binding IsIdle}" DockPanel.Dock="Left" Background="#24755F"/>
            <Button Content="Ακύρωση  Esc" Click="Cancel_Click"
                    IsEnabled="{Binding IsBusy}" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding Status}" Foreground="#B9CBE0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="10,0,0,0"/>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                    CornerRadius="12" Padding="15">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="ΠΙΝΑΚΕΣ &amp; VIEWS" FontWeight="Bold" FontSize="15"
                               Margin="0,0,0,12" DockPanel.Dock="Top"/>
                    <DataGrid ItemsSource="{Binding Objects}"
                              SelectedItem="{Binding SelectedObject, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Αντικείμενο" Binding="{Binding QualifiedName}" Width="*"/>
                            <DataGridTextColumn Header="Τύπος" Binding="{Binding Kind}" Width="100"/>
                            <DataGridTextColumn Header="Πεδία" Binding="{Binding ColumnCount}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBackground}"
                    CornerRadius="12" Padding="15">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="ΠΕΔΙΑ ΕΠΙΛΕΓΜΕΝΟΥ ΑΝΤΙΚΕΙΜΕΝΟΥ"
                               FontWeight="Bold" FontSize="15" Margin="0,0,0,12"
                               DockPanel.Dock="Top"/>
                    <DataGrid ItemsSource="{Binding SelectedColumns}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Πεδίο" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Τύπος" Binding="{Binding DataType}" Width="110"/>
                            <DataGridCheckBoxColumn Header="NULL" Binding="{Binding IsNullable}" Width="58"/>
                            <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey}" Width="45"/>
                            <DataGridCheckBoxColumn Header="FK" Binding="{Binding IsForeignKey}" Width="45"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="READ-ONLY • Δεν πραγματοποιούνται μεταβολές σε δεδομένα ERP."
                       Foreground="#8ECAA9" DockPanel.Dock="Left"/>
            <TextBlock Text="Ctrl+F: Server  •  Ctrl+T: Test  •  Ctrl+R: Scan  •  Esc: Cancel"
                       HorizontalAlignment="Right" Foreground="#8798AA"/>
        </DockPanel>
    </Grid>
</Window>
